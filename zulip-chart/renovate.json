{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Disable updates for everything by default.",
      "matchPackagePatterns": [".*"],
      "enabled": false
    },
    {
      "description": "Track Zulip server only. Humans review every bump.",
      "matchPackageNames": ["ghcr.io/zulip/zulip-server"],
      "enabled": true,
      "automerge": false,
      "labels": ["zulip-upgrade", "needs-release-notes"]
    }
  ]
}
